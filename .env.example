# The service is intentionally local-only by default.
WEB_GUI_AGENT_HOST=127.0.0.1
WEB_GUI_AGENT_PORT=8000
WEB_GUI_AGENT_MAX_CONCURRENT_RUNS=2
WEB_GUI_AGENT_DEFAULT_TIMEOUT_MS=120000
WEB_GUI_AGENT_DEFAULT_MAX_RETRIES=2
# Set locally only; never commit this credential.
WEB_GUI_AGENT_DEEPSEEK_API_KEY=
WEB_GUI_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
WEB_GUI_AGENT_DEEPSEEK_MODEL=deepseek-chat
